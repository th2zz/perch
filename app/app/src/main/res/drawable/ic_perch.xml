<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon is a vector so the repository holds no binary assets and the
  icon scales to every density without a build step. The mark is a branch with a
  resting point on it: work continuing on its own, and one place that waits for
  a person.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#1F6FEB"
        android:pathData="M0,0h108v108H0z" />

    <!-- The trunk: the many agents running in parallel. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M34,24 L34,70" />

    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M34,44 L58,44" />

    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M34,62 L52,62" />

    <!-- The waiting point: the one branch that stopped for a decision. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M74,38 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0" />

</vector>
