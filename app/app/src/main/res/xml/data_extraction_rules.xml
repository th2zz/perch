<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing the app stores is worth extracting, and one thing is actively harmful
  to extract: the pairing token identifies this phone to the user's bridge.
  Backups and device-to-device transfers are therefore excluded wholesale, which
  also matches the honest story: everything except the value statistics can be
  rebuilt from the computer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
