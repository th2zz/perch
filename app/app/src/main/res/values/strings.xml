    <!--
      Closing a session stops whatever is running in it, and there is no undo in herdr — so the sentence says
      that, and says what the agent was doing, because "an agent was working" is the fact that decides it.
    -->
    <string name="manage_close_session_title">Close this session?</string>
    <string name="manage_close_session_working">%1$s is working right now. Closing this session stops it, and that work is gone.</string>
    <string name="manage_close_session_body">The program in this session stops and the session disappears. This cannot be undone.</string>
    <string name="manage_close_session_confirm">Close it</string>
    <!--
      Measured on a live herdr (2026-10-15): closing the *last* session of a project closes the project too,
      because herdr has no such thing as an empty project. One sentence, and it is the difference between a
      close somebody meant and a project that vanished.
    -->
    <string name="manage_close_last_session">This is the last session in %1$s — closing it closes the project as well.</string>
    <string name="manage_close_project_title">Close %1$s?</string>
    <string name="manage_close_project_body">Every session in this project stops and the project disappears. This cannot be undone.</string>
    <!--
      A plural, not a sentence with an "s" on the end. Found on a device (2026-10-15): the first version said
      "1 sessions are running in it" over a project that held exactly one, which reads like the app does not
      know what it is about to close — the worst possible impression for this particular dialog.
    -->
    <plurals name="manage_close_project_count">
        <item quantity="one">%1$d session is running in it.</item>
        <item quantity="other">%1$d sessions are running in it.</item>
    </plurals>
    <string name="manage_close_project_confirm">Close the project</string>
    <!--
      A button that sends a picture of this screen to the user's own computer.

      It is here because two days of "the terminal is black" were two days of nobody being able to *see*
      the screen: a question about pixels, argued with words. Nothing takes a picture on its own — this is
      a button, and the picture goes to the machine the phone is already paired with.
    -->
    <string name="terminal_send_screen">Send screen</string>
    <string name="terminal_ended">The terminal stopped: %1$s</string>
    <!--
      The escape hatch's key bar. Two sentences matter here and both have to be
      true: what the keys are for, and why there is no one-tap answer for this
