<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      User-facing text lives here so it can be translated without touching code.
      The vocabulary is deliberately small (spec SC-005 caps the jargon the user
      must learn at three terms: computer, project, agent).
    -->
    <string name="app_name">Perch</string>
    <string name="pair_title">Add your computer</string>
    <!-- The designed path is a link you tap, so the copy leads with it. The form
         below is the fallback, not the instruction. -->
    <string name="pair_step_one">On your computer, run:</string>
    <string name="pair_command">perch-bridge pair</string>
    <string name="pair_step_two">It prints a perch:// link. Send it to yourself in any chat app, open it on this phone, and tap Connect. That is the whole setup.</string>
    <string name="pair_manual_heading">Or type the two values by hand</string>
    <string name="pair_address">Address</string>
    <string name="pair_token">Token</string>
    <string name="pair_action">Connect</string>
    <string name="pair_no_config_needed">Perch does not change anything on your computer. Your projects and agents stay exactly as they are.</string>
    <!--
      A failure on this phone, not on the computer: the token is encrypted with a key
      in the phone's keystore, and that can be unavailable. Saying "could not reach the
      computer" here would send the user to debug a machine that just answered.
    -->
    <string name="pair_store_failed">This phone could not store the connection securely, so Perch did not connect.</string>
    <string name="pair_bad_address">That does not look like an address or a pairing link. It should be like 100.64.0.1:45999, or the perch:// link from your computer.</string>
    <string name="pair_paste_hint">You can also paste the whole perch:// link into either field.</string>
    <string name="nothing_waiting">Nothing needs you right now.</string>
    <string name="status_working">working</string>
    <string name="status_idle">idle</string>
    <string name="status_blocked">waiting on you</string>
    <string name="status_done">finished</string>
    <string name="status_unknown">unknown</string>

    <!-- Notifications -->
    <string name="channel_decisions">Decisions</string>
    <string name="channel_decisions_desc">Tells you when an agent is waiting for you. This is the one to keep loud.</string>
    <string name="channel_watching">Staying connected</string>
    <string name="channel_watching_desc">A quiet line while Perch keeps in touch with your computer. Safe to silence.</string>
    <string name="decision_title">%1$s needs you in %2$s</string>
    <!--
      The same sentence when the request is on another computer (spec FR-016):
      without the machine name, two cards from two computers read identically.
    -->
    <string name="decision_title_on_host">%1$s needs you in %2$s on %3$s</string>
    <string name="decision_no_detail">The agent is waiting. Open Perch to see what it asked.</string>
    <string name="decision_others_waiting">+%1$d more waiting</string>
    <string name="decision_needs_computer">This one needs the computer — Perch cannot press it for you.</string>
    <string name="action_approve">Approve</string>
    <string name="action_reject">Reject</string>
    <string name="problem_title">That did not go through</string>
    <string name="watching_title">Perch is watching your computer</string>
    <string name="watching_live">Connected. Nothing needs you right now.</string>
    <string name="watching_connecting">Connecting…</string>
    <string name="watching_retrying">Not connected — will keep trying.</string>
    <string name="watching_unpaired">Not set up yet. Open Perch to add your computer.</string>
    <!--
      The line above the queue. Separate from the service's notification text on
      purpose: a notification may say "nothing needs you right now", but this line
      sits directly above the queue and must not contradict it — which it did, in
      the first version, claiming nothing needed you above a waiting decision.
    -->
    <string name="connection_live">Connected to your computer.</string>
    <string name="connection_retrying">Not connected — retrying.</string>
    <string name="request_resolved_elsewhere">A request is no longer waiting on you, so it has left your queue.</string>

    <!-- Queue -->
    <string name="tab_decisions">Waiting</string>
    <string name="tab_projects">Projects</string>
