<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only requested when the user has something waiting; see Notifications.kt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      The watching service keeps one socket open to the user's own computer so a
      decision reaches the phone in about a second, without routing anything
      through a third-party push service. SUFFIX: "specialUse" is the correct
      type because the connection is to a device the user owns rather than to a
      cloud backend; see BridgeWatchService for the trade being made.

    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      Only ever requested the first time the user taps the microphone inside the
      reply box, and only when they have set up their own transcription key. Voice
      is an optional convenience here: with no key the entry does not exist, and
      nothing asks for this permission.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".PerchApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_perch"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Perch">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Tapping the pairing link the computer prints. This is the whole
              zero-typing story: the link carries the address and the secret, so
              the user never reads a number out loud or copies a token by hand.
              Declared for the default browser category too, because the link
              usually arrives inside a chat app.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="perch" android:host="pair" />
            </intent-filter>
        </activity>

        <service
            android:name=".features.queue.BridgeWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!--
              Why `specialUse` and not `dataSync`, which is the type whose name
              sounds right for a background connection: on Android 15 and up the
              system permits a `dataSync` service to run for a total of six hours
              in any twenty-four, then stops it. A product whose whole promise is
              "this works while you are away from your desk" cannot be switched off
              after six hours. `specialUse` is also the type that Android 15 still
              allows a boot receiver to start, which is what makes the service come
              back after a restart.

              Both facts are from the Android 15 behaviour-changes documentation,
              and both are the kind of thing that is easy to "simplify" later
              without noticing, which is why they are written down here.
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains a user-initiated connection to the user's own computer so that coding-agent decisions reach the phone immediately, without a third-party push service." />
        </service>

        <!-- Approve / Reject tapped on a notification; not exported, the system
             delivers these to us through our own PendingIntents. -->
        <receiver
            android:name=".features.queue.DecisionActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".features.queue.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
